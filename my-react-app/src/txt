
import { useState, useCallback } from "react";
import { HOTELS } from "./data/hotels";

import {
  HOTEL_RATIO_CAB,
  HOTEL_RATIO_NO_CAB,
  TRANSPORT_RATIO,
  STAR_LABELS,
  TAG_COLORS,
  CAB_TYPES,
} from "./data/constants";

import {
  localDateStr,
  parseLocalDate,
  formatDate,
  calculateDays,
} from "./utils/dateUtils";

import {
  hotelBudget,
  hotelBudgetLabel,
  pickCab,
} from "./utils/budgetUtils";

import { Step1 } from "./Steps/Step1";
import { Step2 } from "./Steps/Step2";
import { Step3 } from "./Steps/Step3";
import { ShortageScreen } from "./Screen/ShortageScreen";
import { HotelSelector } from "./Screen/HotelSelector";

export default function SmartHolidayPlanner() {
  const [screen, setScreen] = useState("form");
  const [planResult, setPlanResult] = useState(null);
  const [shortageCtx, setShortageCtx] = useState(null);
  const [hotelSelectCtx, setHotelSelectCtx] = useState(null);
  const [booking, setBooking] = useState(null);
  const [prefillForm, setPrefillForm] = useState(null);

  const reset = useCallback(() => {
    setScreen("form");
    setPlanResult(null);
    setShortageCtx(null);
    setHotelSelectCtx(null);
    setBooking(null);
    setPrefillForm(null);
  }, []);

  const buildPlan = useCallback((form, overrideHotel = null) => {
    const {
      budget,
      city,
      checkIn,
      checkOut,
      travelers,
      wantsCab,
      cabType,
      stars,
    } = form;

    const days = calculateDays(checkIn, checkOut);
    const hBudget = hotelBudget(budget, wantsCab);
    const tBudget = wantsCab ? budget * TRANSPORT_RATIO : 0;

    const cityHotels = HOTELS[city] || [];

    const hotel =
      overrideHotel || cityHotels.find((h) => h.stars === stars) || null;

    if (!hotel) {
      setHotelSelectCtx({
        budget,
        hotelBudget: hBudget,
        days,
        cityHotels,
        wantsCab,
        cabType,
        travelers,
        city,
        checkIn,
        checkOut,
        form,
      });

      setScreen("hotelSelect");
      return;
    }

    const hotelCost = hotel.price * days;
    const isOverBudget = hotelCost > hBudget;

    if (!overrideHotel && isOverBudget) {
      setShortageCtx({
        budget,
        hotelBudget: hBudget,
        days,
        preferred: hotel,
        cityHotels,
        wantsCab,
        cabType,
        travelers,
        city,
        checkIn,
        checkOut,
        form,
      });

      setScreen("shortage");
      return;
    }

    const cab = wantsCab
      ? pickCab(budget, hotelCost, days, cabType, travelers)
      : null;

    setPlanResult({
      hotel,
      hotelCost,
      cab,
      days,
      wantsCabService: wantsCab,
      cabBookingType: cabType,
      city,
      checkIn,
      checkOut,
      travelers,
      budget,
      isOverBudget,
      hotelBudget: hBudget,
      allHotels: cityHotels,
      stars: hotel.stars,
      breakdown: {
        hotelBudget: hBudget,
        transportBudget: tBudget,
      },
    });

    setScreen("plan");
  }, []);

  const handleFormSubmit = useCallback(
    (form) => {
      buildPlan(form);
    },
    [buildPlan]
  );

  const handleIncreaseBudget = useCallback(
    (newBudget) => {
      const ctx = shortageCtx;

      setPrefillForm({
        ...ctx.form,
        budget: String(newBudget),
      });

      reset();
      setScreen("form");

      setTimeout(() => {
        setPrefillForm({
          ...ctx.form,
          budget: String(newBudget),
        });
      }, 0);
    },
    [shortageCtx, reset]
  );

  const handleSelectHotel = useCallback(
    (hotel) => {
      const ctx = hotelSelectCtx || shortageCtx;
      buildPlan(ctx.form, hotel);
    },
    [hotelSelectCtx, shortageCtx, buildPlan]
  );

  const handleShowOtherHotels = useCallback(() => {
    const pr = planResult;

    setHotelSelectCtx({
      budget: pr.budget,
      hotelBudget: pr.hotelBudget,
      days: pr.days,
      cityHotels: pr.allHotels,
      wantsCab: pr.wantsCabService,
      cabType: pr.cabBookingType,
      travelers: pr.travelers,
      city: pr.city,
      checkIn: pr.checkIn,
      checkOut: pr.checkOut,
      form: {},
    });

    setScreen("hotelSelect");
  }, [planResult]);

  const css = `
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Inter, system-ui, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(99,102,241,0.2), transparent 25%),
        radial-gradient(circle at bottom right, rgba(14,165,233,0.18), transparent 25%),
        linear-gradient(135deg, #eef2ff 0%, #f8fafc 50%, #e0f2fe 100%);
      min-height: 100vh;
      color: #111827;
    }

    .planner-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px 60px;
    }

    .hero {
      position: relative;
      overflow: hidden;
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(14px);
      border: 1px solid rgba(255,255,255,0.5);
      border-radius: 32px;
      padding: 50px 40px;
      box-shadow: 0 20px 50px rgba(15,23,42,0.12);
      margin-bottom: 30px;
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 240px;
      height: 240px;
      background: rgba(99,102,241,0.15);
      border-radius: 50%;
      top: -80px;
      right: -50px;
      filter: blur(20px);
    }

    .hero-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
      position: relative;
      z-index: 2;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border-radius: 999px;
      background: rgba(79,70,229,0.12);
      color: #4338ca;
      font-size: 0.9rem;
      font-weight: 700;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-size: clamp(2.3rem, 5vw, 4rem);
      line-height: 1.1;
      margin-bottom: 14px;
      color: #0f172a;
      font-weight: 800;
      letter-spacing: -1px;
    }

    .hero p {
      color: #475569;
      font-size: 1.08rem;
      max-width: 650px;
      line-height: 1.7;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-top: 35px;
      position: relative;
      z-index: 2;
    }

    .stat-card {
      background: rgba(255,255,255,0.85);
      border: 1px solid rgba(226,232,240,0.7);
      border-radius: 22px;
      padding: 22px;
      box-shadow: 0 10px 25px rgba(15,23,42,0.06);
      transition: all 0.3s ease;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 30px rgba(15,23,42,0.12);
    }

    .stat-title {
      font-size: 0.92rem;
      color: #64748b;
      margin-bottom: 10px;
      font-weight: 600;
    }

    .stat-value {
      font-size: 1.5rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 6px;
    }

    .stat-desc {
      color: #6b7280;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .main-card {
      background: rgba(255,255,255,0.82);
      backdrop-filter: blur(18px);
      border: 1px solid rgba(255,255,255,0.7);
      border-radius: 32px;
      padding: 40px;
      box-shadow: 0 20px 50px rgba(15,23,42,0.1);
      margin-bottom: 30px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .feature-card {
      background: rgba(255,255,255,0.88);
      border: 1px solid rgba(226,232,240,0.7);
      border-radius: 24px;
      padding: 28px;
      box-shadow: 0 10px 30px rgba(15,23,42,0.06);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .feature-card::before {
      content: "";
      position: absolute;
      width: 100%;
      height: 4px;
      top: 0;
      left: 0;
      background: linear-gradient(90deg, #6366f1, #0ea5e9);
    }

    .feature-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 18px 35px rgba(15,23,42,0.12);
    }

    .feature-icon {
      width: 58px;
      height: 58px;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 18px;
      background: linear-gradient(135deg, #6366f1, #0ea5e9);
      color: white;
      box-shadow: 0 10px 20px rgba(99,102,241,0.3);
    }

    .feature-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 10px;
    }

    .feature-desc {
      font-size: 0.95rem;
      line-height: 1.6;
      color: #64748b;
    }

    .floating-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 18px;
      border-radius: 999px;
      background: rgba(255,255,255,0.92);
      border: 1px solid rgba(226,232,240,0.8);
      box-shadow: 0 10px 20px rgba(15,23,42,0.08);
      font-size: 0.92rem;
      color: #334155;
      font-weight: 600;
    }

    @media (max-width: 900px) {
      .hero-stats,
      .footer-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        padding: 35px 24px;
      }

      .main-card {
        padding: 24px;
      }
    }

    @media (max-width: 600px) {
      .planner-wrapper {
        padding: 20px 14px 40px;
      }

      .hero h1 {
        font-size: 2.2rem;
      }

      .hero p {
        font-size: 0.98rem;
      }

      .main-card,
      .hero {
        border-radius: 24px;
      }

      .grid-2,
      .btn-group,
      .tourist-grid {
        grid-template-columns: 1fr !important;
      }
    }
  `;

  return (
    <>
      <style>{css}</style>

      <div className="planner-wrapper">
        <section className="hero">
          <div className="hero-top">
            <div>
              <div className="hero-badge">
                ✨ AI Powered Budget Travel Planner
              </div>

              <h1>
                Plan Smarter.
                <br />
                Travel Better.
              </h1>

              <p>
                Your planner automatically balances hotels, transport,
                and budget so you stop opening 47 tabs like a stressed
                raccoon comparing hotel prices at 2 AM.
              </p>
            </div>

            <div className="floating-chip">
              🌍 Multi-City Travel Optimization
            </div>
          </div>

          <div className="hero-stats">
            <div className="stat-card">
              <div className="stat-title">Smart Budget Split</div>
              <div className="stat-value">70/30</div>
              <div className="stat-desc">
                Automatically distributes budget between hotel and transport.
              </div>
            </div>

            <div className="stat-card">
              <div className="stat-title">Instant Planning</div>
              <div className="stat-value">&lt; 30 Sec</div>
              <div className="stat-desc">
                Generate optimized holiday plans without manual calculations.
              </div>
            </div>

            <div className="stat-card">
              <div className="stat-title">Budget Friendly</div>
              <div className="stat-value">100%</div>
              <div className="stat-desc">
                Prevents overspending and suggests better hotel alternatives.
              </div>
            </div>
          </div>
        </section>

        <main className="main-card">
          {screen === "form" && (
            <Step1
              key={prefillForm ? JSON.stringify(prefillForm) : "default"}
              onSubmit={handleFormSubmit}
              initialValues={prefillForm}
            />
          )}

          {screen === "shortage" && shortageCtx && (
            <ShortageScreen
              ctx={shortageCtx}
              onIncreaseBudget={handleIncreaseBudget}
              onPickHotel={() => {
                setHotelSelectCtx(shortageCtx);
                setScreen("hotelSelect");
              }}
              onReset={reset}
            />
          )}

          {screen === "hotelSelect" && hotelSelectCtx && (
            <HotelSelector
              ctx={hotelSelectCtx}
              onSelect={handleSelectHotel}
              onReset={reset}
            />
          )}

          {screen === "plan" && planResult && (
            <Step2
              plan={{
                pr: planResult,
                cityHotels: planResult.allHotels,
                onConfirm: (b) => {
                  setBooking(b);
                  setScreen("confirm");
                },
                onShowOtherHotels: handleShowOtherHotels,
              }}
              onReset={reset}
            />
          )}

          {screen === "confirm" && planResult && booking && (
            <Step3
              pr={planResult}
              booking={booking}
              onReset={reset}
            />
          )}
        </main>

        <section className="footer-grid">
          {[
            {
              icon: "⚡",
              title: "Auto Optimization",
              desc: "Your budget is intelligently distributed between hotel, transport, and stay duration.",
            },
            {
              icon: "🏨",
              title: "Best Hotel Match",
              desc: "Find hotels matching your budget and star preference without endless scrolling.",
            },
            {
              icon: "🚕",
              title: "Smart Cab Planning",
              desc: "Automatically recommends suitable cab types based on traveler count and cost.",
            },
          ].map((item) => (
            <div className="feature-card" key={item.title}>
              <div className="feature-icon">{item.icon}</div>
              <div className="feature-title">{item.title}</div>
              <div className="feature-desc">{item.desc}</div>
            </div>
          ))}
        </section>
      </div>
    </>
  );
}
